# 复制为 .env 后修改。留空即用默认值。
# 字段说明见 README.md「配置」。

HOST=0.0.0.0
PORT=6006
SGLANG_URL=http://localhost:8000/v1/audio/speech
AUDIO_DIR=static_audio
DB_FILE=tts_tasks.db

# 磁盘用量驱动的产物保留策略。已用率按小数写（0.9，不是 90）。
# 用量 ≤ START：成功产物不按时间删。
# START < 用量 ≤ LIMIT：保留时间从 MAX 线性降到 FLOOR。
# 用量 > LIMIT：保留 FLOOR。
# 用量 > CRITICAL：强制回收到 LIMIT，失败产物先删。
DISK_USAGE_START=0.80
DISK_USAGE_LIMIT=0.90
DISK_USAGE_CRITICAL=0.95
RETENTION_FLOOR_SECONDS=300
RETENTION_MAX_SECONDS=1800
